# Optional deployment configuration.
# SPARROW_DEPLOYMENTS=conf/deployment.json

# Optional multi-publisher preview registration file.
# SPARROW_PREVIEW_ALIASES_FILE=conf/preview_aliases.json

# Legacy single-preview fallback.
# Do not combine these with SPARROW_PREVIEW_ALIASES_FILE.
# SPARROW_PREVIEW_SOURCE_HOST=test-travel-templates.beta.123presto.com
# SPARROW_PREVIEW_HOST=sparrow-ssr.onrender.com

# Add RunMode for render deployment
# SPARROW_RUNMODE=prod

# Optional server port.
# PORT=8080

# PostgreSQL URLs must include sslmode=require
# or an appropriate stronger TLS verification mode.

# Direct connection, also used as runtime fallback.
DATABASE_URL=

# Preferred runtime connection for the web application.
DATABASE_URL_POOLED=

# Preferred direct connection for the seed command.
DATABASE_URL_DIRECT=

# Explicitly enable read-only Neon integration tests when required.
# SPARROW_TEST_NEON=1
