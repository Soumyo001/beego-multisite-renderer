
# Sparrow SSR - local development only.
# Do not deploy this company assessment to public hosting.

# Publisher deployment metadata.
# SPARROW_DEPLOYMENTS=conf/deployment.json

# Optional explicit local preview hostname.
# The hostname must resolve to your local development server.
# SPARROW_PREVIEW_SOURCE_HOST=test-travel-templates.beta.123presto.com
# SPARROW_PREVIEW_HOST=local-preview.example.test

# Local server configuration.
# Defaults to 127.0.0.1:8080.
# Only use a private LAN address if company policy permits it.
# SPARROW_BIND_HOST=127.0.0.1
# PORT=8080

# Beego development mode.
# SPARROW_RUNMODE=dev

# PostgreSQL URLs must include sslmode=require
# or an appropriate stronger TLS verification mode.

# Direct connection, also used as runtime fallback.
DATABASE_URL=

# Runtime pooled connection option.
DATABASE_URL_POOLED=

# Preferred direct connection for the seed command.
DATABASE_URL_DIRECT=

# Explicitly enable read-only Neon integration tests when required.
# SPARROW_TEST_NEON=1
