# Beego Multisite Renderer - local development only.
# Do not deploy this company assessment to public hosting.

# Publisher deployment metadata.
DEPLOYMENTS=conf/deployment.json

# Requests to localhost / 127.0.0.1 are served as this publisher,
# so the site opens at http://localhost:8080/.
LOCAL_SITE_HOST=test-travel-templates.beta.123presto.com

# Local server configuration.
# Without PORT: 127.0.0.1:8080 (this computer only)
# With PORT: 0.0.0.0:<PORT> (also reachable from the local network)
# PORT=8080

# Beego development mode.
RUNMODE=dev

# PostgreSQL connection URL. Leave empty to let run.sh start a local
# Docker database and fill this in with a generated password.
# A remote database must use sslmode=require (or verify-ca / verify-full);
# a database on this machine may use sslmode=disable.
DATABASE_URL=

# Optional pooled connection, used only when DATABASE_URL is empty.
DATABASE_URL_POOLED=

# Explicitly enable read-only Neon integration tests when required.
# TEST_NEON=1
